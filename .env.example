# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override default model (default: claude-sonnet-4-5)
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: only needed once you wire up Postgres persistence (see docs/data-model.md)
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/mediaforge?sslmode=require

# Optional: Firecrawl fallback for login-walled pages (xhs, WeChat). Without it the local fetcher is used as-is.
FIRECRAWL_API_KEY=fc-...
