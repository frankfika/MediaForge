# No keys needed to run: with ANTHROPIC_API_KEY unset, a built-in mock LLM takes over
# (everything incl. the "试一下" demo and e2e tests works offline of any provider).

# Optional: enables the real Claude model instead of the mock
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override default model (default: claude-sonnet-4-5)
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: only needed once you wire up Postgres persistence (see docs/data-model.md)
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/mediaforge?sslmode=require

# Optional: Firecrawl fallback for login-walled pages (xhs, WeChat). Without it the local fetcher is used as-is.
FIRECRAWL_API_KEY=fc-...
# Leave empty to use the Firecrawl SaaS; set to your URL when self-hosting.
FIRECRAWL_BASE_URL=

# Reserved (not read by the code yet): Jina Reader as another fetch fallback
JINA_API_KEY=jina-...
