# EditorConfig: keep one editor's whitespace from polluting another.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown hard-wraps are fragile in PRs; respect trailing spaces
# used by some plugins (line breaks).
[*.md]
trim_trailing_whitespace = false

# Go and Rust use tabs.
[*.{go,rs}]
indent_style = tab

# Python keeps four-space indents.
[*.py]
indent_size = 4